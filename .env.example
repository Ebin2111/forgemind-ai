# Copy to .env and fill in values
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash   # gemini-2.0-flash has been shut down
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TEMPERATURE=0.1
MAX_CONTEXT_CHARS=12000
DATABASE_URL=sqlite:///./data/forgemind.db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ENABLE_SEMANTIC_SEARCH=false
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- added in v0.2.0 ---
APP_ENV=development        # development | staging | production | test (production hides /docs)
LOG_LEVEL=INFO
# true = load the demo equipment and work orders from data/sample on startup; false = start empty
SEED_SAMPLE_DATA=false
LOG_FORMAT=text   # text (readable) or json (for log collectors)
MAX_UPLOAD_MB=25
API_PREFIX=/api

# --- sign-in (user accounts with roles: admin and technician) ---
AUTH_ENABLED=true
# The FIRST administrator. Created automatically on start-up when no user exists yet (password: 8+ characters).
# After that, add and manage people on the Users page; changing these lines later does not change existing accounts.
ADMIN_EMAIL=admin@forgemind.local
ADMIN_PASSWORD=ChangeMe-Now-123      # CHANGE THIS. Production refuses to start with this value.
SESSION_SECRET=                      # random text that signs the login cookie. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SESSION_HOURS=12                     # session length without "Remember me"
REMEMBER_DAYS=30                     # session length with "Remember me"

# --- Docker Compose (docker compose up --build -d) ---
# BIND_ADDRESS=127.0.0.1     # 0.0.0.0 exposes the API; it has no login yet
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
# BACKEND_MEM_LIMIT=1g       # use 3g or more with semantic search
# INSTALL_SEMANTIC=false     # true = build with sentence-transformers + FAISS (set ENABLE_SEMANTIC_SEARCH=true too)
# NEXT_PUBLIC_API_URL above must be the URL your BROWSER uses to reach the API; it is built into the frontend.
