# Copy this file to .env ON THE SERVER and fill it in. Never share it or put it on GitHub.

# The address people will open, without https:// (for example forgemind-plant.duckdns.org or app.mycompany.com)
DOMAIN=your-name.duckdns.org

# Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# The first administrator, created automatically the first time the server starts.
# On a public server the password must be at least 12 characters, private, and not the example value.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# A long random value (32+ characters) that signs the login cookies. Make one with:  openssl rand -hex 32
SESSION_SECRET=

SEED_SAMPLE_DATA=false
